# Copier vers .env puis remplir. Ne JAMAIS committer .env.
DB_NAME=allodocteur
DB_USER=allodocteur
DB_PASSWORD=change-me

# >= 32 caractères aléatoires :  openssl rand -base64 48
APP_JWT_SECRET=
# Clé AES-256 en Base64 (32 octets) :  openssl rand -base64 32
APP_CRYPTO_KEY=

# Compte administrateur initial (créé au premier démarrage si absent)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=

APP_FRONTEND_URL=http://localhost:8081
APP_CORS_ORIGINS=http://localhost:8081
# true en production (HTTPS)
APP_COOKIE_SECURE=false
# 2FA obligatoire pour les admins SUPER/FINANCE (true par défaut ; ne désactiver qu'en développement)
APP_REQUIRE_ADMIN_MFA=true
